# Add these in Vercel: Project > Settings > Environment Variables. Never commit real values.
APP_URL=https://innoleadafrica.com

# AuthGate (dashboard > API Keys). Keep the key secret.
AUTHGATE_URL=https://authgate.dev
AUTHGATE_API_KEY=ag_live_xxxxxxxxxxxxxxxx

# Any long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=

# Added automatically when you connect Upstash Redis from the Vercel Marketplace
# (either UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN or KV_REST_API_URL / KV_REST_API_TOKEN)

# Payment notification emails (Resend: create a key, then verify your sending domain in its dashboard)
RESEND_API_KEY=
MAIL_FROM=Innolead Website <notifications@innoleadafrica.com>
ACADEMY_EMAIL=academy@innoleadafrica.com
